# Entorno de DESARROLLO (Sail). Para producción usa .env.production.example.
APP_NAME=Proyecto-Kudos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8095
APP_PORT=8095

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=kudos_db
DB_USERNAME=sail
DB_PASSWORD=password

# Orígenes permitidos por CORS, separados por comas. El primero se usa además
# para construir los enlaces de los correos (verificación y reset de contraseña).
FRONTEND_URL=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# En local los correos se envían en la misma petición (sync) para no necesitar un worker.
# En producción es "database" y los procesa el servicio worker.
QUEUE_CONNECTION=sync

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="kudos@admin.com"
MAIL_FROM_NAME="${APP_NAME}"

# Verificación de email: false = las cuentas se crean ya verificadas (sin correo).
# true = flujo completo con enlace firmado (en local los correos llegan a Mailpit: http://localhost:8025).
AUTH_EMAIL_VERIFICATION=false

# Administrador que crea UserSeeder (solo local; en producción se eligen otros valores).
SEED_ADMIN_NAME=kudosAdmin
SEED_ADMIN_EMAIL=admin@kudos.com
SEED_ADMIN_PASSWORD=password123

WWWUSER=1000
WWWGROUP=1000
