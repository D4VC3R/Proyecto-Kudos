# Contexto de construcción de la imagen de producción (Backend/Dockerfile).
# Todo lo que no se excluye aquí se envía a Docker y puede acabar dentro de la imagen.

# Secretos y configuración local: las variables llegan en tiempo de ejecución (env_file)
.env
.env.*

# Dependencias: se instalan dentro de la imagen sin las de desarrollo
vendor
node_modules

# Cachés de arranque generadas en local: registrarían proveedores de desarrollo (Pail, Sail)
# que no existen con --no-dev y la aplicación no arrancaría
bootstrap/cache/*.php

# Datos locales: imágenes subidas, logs y cachés del entorno de desarrollo
storage/app/*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
public/storage
public/hot
public/build

# Desarrollo, tests y documentación
.git
.github
.idea
.vscode
.fleet
.zed
docker/8.5
docker/pgsql
compose.yml
compose.*.yml
Dockerfile
.dockerignore
tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache
docs
*.md
.editorconfig
.gitattributes
.gitignore
