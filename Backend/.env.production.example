# Entorno de PRODUCCIÓN (VPS). Plantilla SIN secretos: se versiona.
#
#   cp .env.production.example .env.production   (.env.production está en .gitignore)
#
# Genera cada contraseña con:  openssl rand -hex 24
# Hexadecimal a propósito: un '$' en un valor lo interpretaría Compose como una variable.
# Comentarios siempre en su propia línea: Compose y Laravel no interpretan igual los comentarios al final.

APP_NAME=Kudos
APP_ENV=production
# Se genera con: docker compose -f compose.prod.yml --env-file .env.production run --rm app php artisan key:generate --show
APP_KEY=
# NUNCA true en producción: cualquier error mostraría la configuración y las credenciales.
APP_DEBUG=false
APP_URL=https://api.kudos.dcerdan.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs a stderr: se leen con "docker compose logs" y Docker ya los rota (10 MB x 3).
# LOG_LEVEL=info es necesario: el log de auditoría de moderación escribe con nivel info.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Conexiones por nombre de servicio de Docker, nunca localhost.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kudos
DB_USERNAME=kudos
DB_PASSWORD=

# Origen permitido por CORS y base de los enlaces de los correos.
FRONTEND_URL=https://kudos.dcerdan.es

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# La cola vive en PostgreSQL (tabla jobs) y la procesa el servicio worker.
QUEUE_CONNECTION=database
# Los límites diarios de votos dependen de la caché en Redis.
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Verificación de email APAGADA: las cuentas se crean ya verificadas y no se envía correo.
# Para encenderla (true) hace falta antes un proveedor de correo (ver MAIL_* abajo).
AUTH_EMAIL_VERIFICATION=false

# Correo: el dominio no tiene buzones (solo redirecciones), así que no se envía nada (MAIL_MAILER=log).
# Consecuencia: el correo de "olvidé mi contraseña" no llega. Para enviar correos de verdad, configura un
# proveedor SMTP transaccional y verifica el dominio en él. Ejemplo con Resend:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.resend.com  MAIL_PORT=587  MAIL_USERNAME=resend  MAIL_PASSWORD=<API key>
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@dcerdan.es
MAIL_FROM_NAME=Kudos

# Administrador que crea "db:seed" (solo se usa al sembrar).
SEED_ADMIN_NAME=kudosAdmin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
